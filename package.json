{
  "name": "peer-agents-mcp",
  "version": "0.7.0",
  "description": "MCP server for multi-turn peer sessions with Grok and Antigravity CLIs",
  "type": "module",
  "bin": {
    "peer-agents-mcp": "./dist/index.js"
  },
